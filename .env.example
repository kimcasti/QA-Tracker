# Public backend URL used at build time by the frontend.
VITE_API_URL=http://localhost:1337

# Optional Cloudinary config for evidence uploads from clipboard/manual upload.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional business WhatsApp used in the freemium upgrade CTA.
VITE_UPGRADE_WHATSAPP_PHONE=
VITE_UPGRADE_CONTACT_URL=
VITE_RENEW_PLAN_URL=

# Keep disabled in production. The app only honors this flag in local runtimes.
VITE_USE_SERVICE_AUTH=false
VITE_API_IDENTIFIER=
VITE_API_PASSWORD=

# Local automation publishing script config.
QA_TRACKER_API_URL=http://localhost:1337
QA_TRACKER_PROJECT_KEY=
QA_TRACKER_TOKEN=
QA_TRACKER_TOOL=playwright
QA_TRACKER_REPORT_PATH=./playwright-report.json
QA_TRACKER_RUN_TITLE=
QA_TRACKER_BRANCH=
QA_TRACKER_BUILD_VERSION=
QA_TRACKER_ENVIRONMENT=local
QA_TRACKER_TRIGGERED_BY=
QA_TRACKER_EXECUTION_DATE=
QA_TRACKER_TEST_TYPE=smoke
QA_TRACKER_PRIORITY=medium
